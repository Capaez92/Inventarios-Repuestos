# ========================================================
# Configuración del Entorno - AutoStock Pro
# ========================================================

# Clave secreta para sesiones
SECRET_KEY=clave-secreta-segura-2026

# Puerto local
PORT=8090

# ========================================================
# Conexión a Base de Datos:
# ========================================================

# 1. Opción Local por defecto (SQLite):
# DATABASE_URL=sqlite:///instance/inventarios.db

# 2. Opción Supabase (PostgreSQL en la Nube):
# Copia la URI de conexión de tu proyecto en Supabase:
# Settings -> Database -> Connection string -> URI
# Ejemplo:
# DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
